<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Argu" Version="6.2.5" />
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Fake.Core.Target" Version="6.1.4" />
    <PackageVersion Include="Fake.DotNet.Cli" Version="6.1.4" />
    <PackageVersion Include="Fake.Installer.InnoSetup" Version="6.1.4" />
    <PackageVersion Include="Fake.IO.Zip" Version="6.1.4" />
    <PackageVersion Include="FParsec" Version="1.1.1" />
    <PackageVersion Include="FSharp.Core" Version="10.1.400" />
    <PackageVersion Include="FSharp.Data" Version="8.2.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.246" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="IconPacks.Avalonia.FontAwesome" Version="2.0.0" />
    <PackageVersion Include="IconPacks.Avalonia.MaterialDesign" Version="2.0.0" />
    <PackageVersion Include="System.Reactive" Version="5.0.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- pinned transitive to resolve vulnerabilities -->
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
  </ItemGroup>
</Project>